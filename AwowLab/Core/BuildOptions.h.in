#pragma once

// Generated by CMake from AwowLab/Core/BuildOptions.h.in. The values come
// from awowlab.config.json (or -D overrides); edit that instead of the
// generated copy. See docs/BUILD-OPTIONS.md.

#include <cstdint>

// 1 when this build ships the updater and may update itself from
// AWOWLAB_UPDATE_REPO_OWNER/AWOWLAB_UPDATE_REPO_NAME
#cmakedefine01 AWOWLAB_ENABLE_UPDATER

// Web page of the project, without a trailing slash
#define AWOWLAB_PROJECT_URL "@AWOWLAB_PROJECT_URL@"

// GitHub repository the updater installs releases from
#define AWOWLAB_UPDATE_REPO_OWNER "@AWOWLAB_UPDATE_REPO_OWNER@"
#define AWOWLAB_UPDATE_REPO_NAME "@AWOWLAB_UPDATE_REPO_NAME@"

// GitHub repository (owner/name) holding the static assets release
#define AWOWLAB_ASSETS_REPO "@AWOWLAB_ASSETS_REPO@"

// WarcraftLogs OAuth client id sent during sign-in
#define AWOWLAB_WCL_CLIENT_ID "@AWOWLAB_WCL_CLIENT_ID@"

// Local ports WarcraftLogs sign-in listens on, tried in order. Each must be
// registered as http://localhost:<port>/callback on the client.
#define AWOWLAB_WCL_REDIRECT_PORTS @AWOWLAB_WCL_REDIRECT_PORTS@

// Public half of the release signing key, as configured (128 hex characters,
// empty when the build has none)
#define AWOWLAB_SIGNING_PUBLIC_KEY "@AWOWLAB_SIGNING_PUBLIC_KEY@"
#define AWOWLAB_SIGNING_KEY_CONFIGURED @AWOWLAB_SIGNING_KEY_CONFIGURED@

// What the settings file key is derived from (settings_key). Builds with
// different values cannot read each other's settings.
#define AWOWLAB_SETTINGS_KEY "@AWOWLAB_SETTINGS_KEY@"

namespace awow::build {

// The same key as bytes: ECDSA P-256, X coordinate (32 bytes) then Y
// coordinate (32 bytes). All zero when no key is configured.
inline constexpr uint8_t kReleasePublicKey[64] = {
    @AWOWLAB_SIGNING_PUBLIC_KEY_BYTES@
};

} // namespace awow::build
