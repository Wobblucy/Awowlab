AwowLab/PNG/EncounterMaps/
# The full world map set, unpacked from the assets release by the updater or
# tools/fetch-assets.py. The maps committed beside it are the seasonal ones.
AwowLab/PNG/Worldmaps/defaults/
README_PUBLIC.md
window_settings.ini
nul
vcpkg/

# Each builder's own repositories, client id and keys. CMake creates it from
# awowlab.config.example.json on the first configure.
/awowlab.config.json

# =============================================================================
# Tools - Asset Generation Utilities (excluded by default, opt in below)
# =============================================================================
# Use tools/* rather than tools/ : excluding the directory itself stops git from
# descending into it, which makes every ! rule below unreachable.
tools/*

# But keep translation scripts. config.json holds the DeepL API key; no JSON
# file in that folder is ever committed.
!tools/translate/
tools/translate/*.json

# Release packaging, manifest signing and the static asset checksums.
!tools/release/
# Developer tools: the action priority list checker and the live-log replayer.
!tools/analysis/
# Downloads the icons and maps a source build does not include.
!tools/fetch-assets.py
# The index of what lives here.
!tools/README.md

# Keep the game-version update pipeline: these scripts generate the spell, map and
# encounter data that ships, so they need history. Their generated output and the
# bulky DB2 dumps they read stay excluded - regenerate those, don't commit them.
# See docs/UPDATE-FLOW.md.

# Our patches to the tools the data pipeline borrows. See tools/external/README.md.
!tools/external/

# Python bytecode anywhere under tools/
tools/**/__pycache__/

# Blender scripts that render the boss arena maps. See tools/arena-maps/README.md.
!tools/arena-maps/
tools/arena-maps/__pycache__/

!tools/db2_layouts.py
!tools/db2_layouts.json

# The Python packages the tools import, and the check that reports what is missing
!tools/requirements.txt
!tools/check_setup.py
# Exports the DB2 tables from a game install. See tools/db2-export/README.md.
!tools/db2-export/
# Exports the spell icon images from a game install. See tools/icon-export/README.md.
!tools/icon-export/

!tools/db2_extractor/
tools/db2_extractor/output/
tools/db2_extractor/*.log
tools/db2_extractor/output.txt

!tools/spell-data-generator/
tools/spell-data-generator/output/
tools/spell-data-generator/raw-data/
tools/spell-data-generator/*.csv

!tools/worldmap-builder/
tools/worldmap-builder/db2files/
tools/worldmap-builder/output/
tools/worldmap-builder/tiles/
tools/worldmap-builder/pngquant/
# Regenerable intermediate, ~18 MB (generate_master_coordinates.py rebuilds it)
tools/worldmap-builder/master_map_alignment_coordinates.json
tools/worldmap-builder/requiredblps.txt
tools/worldmap-builder/required_blp_files.txt
tools/worldmap-builder/season_*_tiles.csv
tools/worldmap-builder/season_*_fileDataIDs.txt
tools/worldmap-builder/season_*_listfile.csv
tools/worldmap-builder/missing_after_repair_check.txt
# Extracted game assets - pull these from the client, never commit them
tools/worldmap-builder/tiles_blp/
# Third-party binary, download from https://pngquant.org/ . Kept at both paths
# because stitch_map_tiles.py looks in pngquant/ while the other three tools
# expect it one level up.
tools/worldmap-builder/pngquant.exe

!tools/spell-icon-generator/
tools/spell-icon-generator/output/
tools/spell-icon-generator/raw-data/

# icon-culler: the scripts are tracked, its generated packs are not.
# The directory must be re-included before any file inside it can be.
!tools/icon-culler/
tools/icon-culler/output/
tools/icon-culler/__pycache__/

!tools/spell-name-converter/

!tools/generate-encounter-id/
tools/generate-encounter-id/output/

!tools/encounter-map-compressor/
# Game assets pulled from the client by the export helper - ~2 GB of textures,
# OBJs and placement CSVs per dungeon. Extract them, never commit them.
tools/encounter-map-compressor/encounter_export/

!tools/model-extractor/
tools/model-extractor/output/
tools/model-extractor/__pycache__/
# Extracted models, ~400 MB of OBJ. Export them again with wow.export from the
# fdid list beside them (SEASON_MODELS_README.md); what ships is the baked pack
# in AwowLab/data/. The fdid list and the name assignments are the key, so they
# are tracked.
tools/model-extractor/season_models/
tools/model-extractor/season_npc_models.csv

# =============================================================================
# Data - DB2 Export Files (large source files, not needed in repo)
# =============================================================================
# Raw dumps and their text exports: regenerate these, never commit them.
# See docs/UPDATE-FLOW.md.
/rawdb2/
/data/

# AwowLab/data holds the generated data the app loads and data.zip ships, so it
# is tracked. Keep debug artifacts out of it - anything left there downloads to
# every user on every update.
!AwowLab/data/
# Per-user runtime state the app writes next to itself. Never commit: it
# holds one machine's rulings and layout, and tests write scratch data here
# when run from the repo.
AwowLab/User Settings/

# Isolated pulls used to drive the live-log replayer. Real combat logs, often
# hundreds of megabytes - keep them local and regenerate as needed.
testlogs/

# =============================================================================
# Local build output and scratch at the repo root
# =============================================================================
# Release builds are uploaded to the public repo, and spell icons and maps live
# in the assets-v2 release. None of it belongs in source history.
/release-lite/
/release-relwithdebinfo/
/old releases/
/temp_icons/
/temppublic-repo/

# Written by DebugDatabaseDumper, and the spreadsheets made from it.
/debuglogs/
/debuglogexploration/

# The app's per-user state when it runs from the repo root.
/User Settings/

# Demo replays ship in the assets release (DemoReplays.zip), not in the source
/AwowLab/Demo Replays/
